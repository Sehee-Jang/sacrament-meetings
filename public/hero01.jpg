                    function svgToBase64(svg) {
                        return 'data:image/svg+xml;base64,' + btoa(svg);
                    }

                    var isDarkMode = false;
                    if (window.matchMedia) {
                        var mq = window.matchMedia('(prefers-color-scheme: dark)');
                        if (mq.matches) {
                            isDarkMode = true;
                        }
